# 高德开放平台 Web 服务 Key —— 示例模板，真实 Key 不要提交到仓库。
# 获取地址：https://console.amap.com/dev/key/app （Key 类型选「Web服务」）
# 便捷设置（推荐）：python -m src.cli --set-key   （写入系统钥匙串，不必改本文件）
AMAP_KEY=your_key_here

# 运行开关：true = 只读 data/ 本地样例数据（默认，无需网络与 Key）
OFFLINE_DEMO=true

# 老人步行速度（米/秒），用于时间成本估算；默认 0.9，属假设/待验证
SENIOR_SPEED_MPS=0.9
